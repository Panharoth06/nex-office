# ---------------------------------------------------------------------------
# Database — PostgreSQL is the only supported database.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://office:office@localhost:5432/office_engine
DB_POOL_SIZE=20

# ---------------------------------------------------------------------------
# Redis — sessions, ACL cache, pub/sub, presence, rate limits.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Origin & cookies (Docker default; use http://localhost:3000 for local dev)
# ---------------------------------------------------------------------------
APP_ORIGIN=http://localhost:8080
WEB_ORIGIN=http://localhost:8080
SESSION_SECURE_COOKIES=false

# ---------------------------------------------------------------------------
# Rust services
# ---------------------------------------------------------------------------
API_BIND=0.0.0.0:8080
SYNC_BIND=0.0.0.0:8081
SYNC_JWT_SECRET=replace-with-another-long-random-secret
# Local development only. Enables POST /api/auth/dev-login; never enable in production.
DEV_AUTH=false
RUST_LOG=info,sqlx=warn

# ---------------------------------------------------------------------------
# OIDC — leave OIDC_ISSUER empty to disable generic OIDC sign-in.
# ---------------------------------------------------------------------------
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_ID=oidc
OIDC_REDIRECT_URL=http://localhost:8080/api/auth/oidc/callback
OIDC_SCOPES=openid,email,profile

# ---------------------------------------------------------------------------
# Web client
# ---------------------------------------------------------------------------
NUXT_PUBLIC_API_BASE=
NUXT_PUBLIC_SYNC_URL=ws://localhost:8080/ws
# Keep this equal to DEV_AUTH so the login page shows the local sign-in button.
NUXT_PUBLIC_DEV_AUTH=false
